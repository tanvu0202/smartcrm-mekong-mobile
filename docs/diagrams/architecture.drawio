        <mxCell id="c5" parent="1" style="rounded=1;align=left;spacingLeft=6;fontSize=14;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" value="&lt;b&gt;M2 Phân công &amp;amp; lịch hẹn&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;FR02, FR03, FR04, FR07&lt;/span&gt;" vertex="1">
