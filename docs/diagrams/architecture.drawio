        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;align=left;spacingLeft=6;fontSize=14;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" value="&lt;b&gt;M1 Phiếu chờ phân công&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;FR01, FR06, FR08&lt;/span&gt;" vertex="1">
