        <mxCell id="1" parent="0" />
        <mxCell id="c2" parent="1" style="text;fontSize=14;fontStyle=1;align=left;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" value="&lt;b&gt;Kiến trúc 4 lớp – Hệ thống phân công kỹ thuật viên và lịch hẹn bảo hành Mekong Mobile&lt;/b&gt;" vertex="1">
