        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;arcSize=4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;html=1;whiteSpace=wrap;fontFamily=Times New Roman;" value="&lt;b&gt;Lớp 1 · Giao diện (React)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;Trách nhiệm: hiển thị, nhập liệu, kiểm tra định dạng cơ bản; KHÔNG chứa quy tắc nghiệp vụ.&lt;/span&gt;" vertex="1">
