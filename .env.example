# Cách dùng:  cp .env.example .env     (không cần sửa gì vẫn chạy được bằng Docker)
# File này CHỈ chứa GIÁ TRỊ MẪU. File .env thật đã bị git bỏ qua – KHÔNG BAO GIỜ commit.
# Khi triển khai thật: đổi DB_PASSWORD và AUTH_SECRET (xem docs/deployment-guide.md, mục 3).

# --- Cổng mở ra máy chủ khi chạy bằng Docker (đổi nếu cổng 3000 đang bị chiếm) ---
APP_PORT=3000

# --- PostgreSQL ---
# Docker: DB_HOST và DB_PORT được docker-compose.yml tự đặt (db, 5432); các giá trị dưới đây chỉ dùng khi chạy KHÔNG qua Docker.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcrm
DB_USER=postgres
# Mật khẩu CSDL (Docker dùng đúng giá trị này để tạo CSDL). Khi triển khai thật phải đổi.
DB_PASSWORD=doi_thanh_mat_khau_postgres_cua_em

# (Tuỳ chọn, không dùng với Docker) Một chuỗi kết nối duy nhất; nếu điền thì được ưu tiên hơn các biến DB_* ở trên.
# DATABASE_URL=postgresql://postgres:mat_khau@localhost:5432/smartcrm

# --- Ứng dụng ---
PORT=3000

# --- Đăng nhập (Sprint 2, TD-14) ---
# Chuỗi bí mật ký token – đổi thành một chuỗi dài (>= 32 ký tự), sinh bằng:  openssl rand -hex 32
# Để trống thì mỗi lần khởi động lại backend, mọi người bị đăng xuất.
AUTH_SECRET=doi-thanh-mot-chuoi-dai-ngau-nhien-it-nhat-32-ky-tu
# Mật khẩu chung của 3 tài khoản demo công khai (dieu.phoi, ktv.hai, ktv.long). Để trống = demo123
DEMO_PASSWORD=demo123
# Thời hạn token, tính bằng giây (28800 = 8 giờ)
TOKEN_TTL_SECONDS=28800
# Địa chỉ giao diện được phép gọi API từ nguồn khác (chỉ cần khi chạy giao diện dev ở cổng 5173)
CORS_ORIGIN=http://localhost:5173
