# Chỉ khai báo tên biến, KHÔNG ghi giá trị thật (giá trị thật nằm trong .env – không commit)

# Cách 1: một chuỗi kết nối (ưu tiên nếu có)
DATABASE_URL=

# Cách 2: khai báo từng biến (như Buổi 2)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcrm
DB_USER=
DB_PASSWORD=

# Ứng dụng
PORT=3000

# Đăng nhập (Sprint 2, TD-14)
# Chuỗi bí mật ký token – đặt một chuỗi dài ngẫu nhiên. Để trống thì mỗi lần khởi động lại backend, mọi người bị đăng xuất.
AUTH_SECRET=
# Mật khẩu chung của 3 tài khoản demo (dieu.phoi, ktv.hai, ktv.long). Để trống = demo123
DEMO_PASSWORD=
# Thời hạn token, tính bằng giây (để trống = 28800, tức 8 giờ)
TOKEN_TTL_SECONDS=
# Địa chỉ giao diện được phép gọi API trực tiếp (để trống = http://localhost:5173)
CORS_ORIGIN=
