# Cách dùng:  cp .env.example .env   rồi sửa các giá trị cho máy của em.
# File này CHỈ chứa GIÁ TRỊ MẪU (đổi trước khi chạy). File .env thật đã bị git bỏ qua – KHÔNG commit.

# --- PostgreSQL (khai báo từng biến) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcrm
DB_USER=postgres
DB_PASSWORD=doi_thanh_mat_khau_postgres_cua_em

# (Tuỳ chọn) Một chuỗi kết nối duy nhất. Nếu bỏ dấu # và điền thì được ưu tiên hơn các biến DB_* ở trên.
# DATABASE_URL=postgresql://postgres:mat_khau@localhost:5432/smartcrm

# --- Ứng dụng ---
PORT=3000

# --- Đăng nhập (Sprint 2, TD-14) ---
# Chuỗi bí mật ký token – đổi thành một chuỗi dài ngẫu nhiên. Để trống thì mỗi lần khởi động lại backend, mọi người bị đăng xuất.
AUTH_SECRET=doi-thanh-mot-chuoi-dai-ngau-nhien
# Mật khẩu chung của 3 tài khoản demo công khai (dieu.phoi, ktv.hai, ktv.long). Để trống = demo123
DEMO_PASSWORD=demo123
# Thời hạn token, tính bằng giây (28800 = 8 giờ)
TOKEN_TTL_SECONDS=28800
# Địa chỉ giao diện được phép gọi API trực tiếp
CORS_ORIGIN=http://localhost:5173
